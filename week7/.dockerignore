# ==============================================================================
# CyberShield Docker Build Context Ignore List (.dockerignore)
# Prevents secrets, git history, tests, local artifacts, caches & backups
# from leaking into Docker images during build.
# ==============================================================================

# Local Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
.npmrc
.yarnrc
.yarnrc.yml
.pnpmrc

# Backup, Swap & Editor Temp Files
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~
*.dump

# Git Version Control & Metadata
.git
.gitignore
.gitattributes

# Local Dependencies & Build Artifacts
node_modules
.next
out
build
dist

# Test Files & Test Artifacts
test
tests
coverage
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx
*.spec.js
vitest.config.ts

# Documentation & Internal Reports
docs
security
*.md
!README.md
*.report.html

# IDE, Editor & Agent Configurations
.vscode
.idea
.agents
.claude
.cursor
.devin
.gemini

# Logs & Debugging Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Caches & Temporary OS Files
tsconfig.tsbuildinfo
.DS_Store
Thumbs.db

# Cryptographic Keys & Certificates
*.pem
*.key
*.cert
*.crt
